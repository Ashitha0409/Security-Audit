# PRAWL Environment Configuration
# Copy this to .env and fill in your values

# Groq API Key (recommended — free AI summaries & chatbot)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key (optional — higher-quality AI summaries)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API Key (optional — free-tier fallback)
# Get yours at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Breach checks use XposedOrNot (free, no API key required) — nothing to set.

# Neo4j — Threat Map graph store (optional; in-memory fallback if unset/unreachable).
# With docker-compose these are set automatically. For a local Neo4j:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prawl-threat-map

# Flask Settings
FLASK_DEBUG=false
PORT=5000
